.DS_Store

.direnv
.envrc
.worktrees

# grok-cli (superagent-ai/grok-cli) project-local state.
# Global/user state lives in ~/.grok/ (managed declaratively by the
# modules/ai/grok.nix home-manager module, including mcp + sub-agents).
# Never commit this; similar to .claude/, .opencode/, .pi/, etc.
.grok/

__pycache__/
*.py[cod]

result

# OpenTofu state for infra/proxmox: machine-local, holds vmids and volume ids.
# `.terraform.lock.hcl` is deliberately NOT ignored: it pins provider hashes.
.terraform/
*.tfstate
*.tfstate.*
